<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Black surfaces, grouped cards with quiet row lines and one blue accent for state and focus. -->
  <Color x:Key="AccentColor">#3B6FF5</Color>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHover" Color="#5582F7"/>
  <SolidColorBrush x:Key="Ink" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="Secondary" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
  <SolidColorBrush x:Key="Faint" Color="#6B6B6B"/>
  <SolidColorBrush x:Key="Line" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="Edge" Color="#282828"/>
  <SolidColorBrush x:Key="EdgeHover" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Surface" Color="#0D0D0D"/>
  <SolidColorBrush x:Key="DangerText" Color="#FF7B72"/>
  <SolidColorBrush x:Key="Field" Color="#151515"/>
  <SolidColorBrush x:Key="Hover" Color="#161616"/>
  <SolidColorBrush x:Key="Selected" Color="#1E1E1E"/>
  <!-- Caveats the user must read: the notice with extractive notes, an unfinished meeting, a failed model call. -->
  <SolidColorBrush x:Key="WarningText" Color="#E3B341"/>
  <SolidColorBrush x:Key="HitRow" Color="#383B6FF5"/>
  <!-- Notice cards: the edge and kind label of an error and of a neutral note; a warning takes WarningText. -->
  <SolidColorBrush x:Key="ErrorText" Color="#F0524F"/>
  <SolidColorBrush x:Key="NoteText" Color="#7FB0FF"/>
  <SolidColorBrush x:Key="NoticeBehind" Color="#181818"/>
  <Duration x:Key="Fast">0:0:0.12</Duration>

  <!-- 16 px stroke icons. -->
  <Geometry x:Key="IconMicrophone">M8,1.75 C9.1,1.75 10,2.65 10,3.75 L10,7.75 C10,8.85 9.1,9.75 8,9.75 C6.9,9.75 6,8.85 6,7.75 L6,3.75 C6,2.65 6.9,1.75 8,1.75 Z M3.5,7.25 C3.5,9.9 5.5,11.75 8,11.75 C10.5,11.75 12.5,9.9 12.5,7.25 M8,11.75 L8,14.25</Geometry>
  <Geometry x:Key="IconMeetings">M6,7.5 A2.5,2.5 0 1 0 6,2.5 A2.5,2.5 0 1 0 6,7.5 Z M1.75,13.75 C1.75,11.25 3.6,9.75 6,9.75 C8.4,9.75 10.25,11.25 10.25,13.75 M10.25,2.6 A2.45,2.45 0 0 1 10.25,7.4 M12,9.9 C13.4,10.4 14.25,11.75 14.25,13.75</Geometry>
  <Geometry x:Key="IconSliders">M2,4.5 L6.25,4.5 M9.75,4.5 L14,4.5 M2,11.5 L8.25,11.5 M11.75,11.5 L14,11.5 M8,2.75 A1.75,1.75 0 1 1 8,6.25 A1.75,1.75 0 1 1 8,2.75 Z M10,9.75 A1.75,1.75 0 1 1 10,13.25 A1.75,1.75 0 1 1 10,9.75 Z</Geometry>
  <Geometry x:Key="IconGear">M6.47,3.56 L6.69,1.84 L9.31,1.84 L9.53,3.56 A4.7,4.7 0 0 1 11.08,4.45 L12.68,3.78 L13.99,6.05 L12.61,7.1 A4.7,4.7 0 0 1 12.61,8.9 L13.99,9.95 L12.68,12.22 L11.08,11.55 A4.7,4.7 0 0 1 9.53,12.44 L9.31,14.16 L6.69,14.16 L6.47,12.44 A4.7,4.7 0 0 1 4.92,11.55 L3.32,12.22 L2.01,9.95 L3.39,8.9 A4.7,4.7 0 0 1 3.39,7.1 L2.01,6.05 L3.32,3.78 L4.92,4.45 A4.7,4.7 0 0 1 6.47,3.56 Z M8,5.9 A2.1,2.1 0 1 1 8,10.1 A2.1,2.1 0 1 1 8,5.9 Z</Geometry>
  <Geometry x:Key="IconSparkle">M8,1.75 L9.35,6.65 L14.25,8 L9.35,9.35 L8,14.25 L6.65,9.35 L1.75,8 L6.65,6.65 Z</Geometry>
  <Geometry x:Key="IconBook">M3,3.25 C3,2.8 3.3,2.5 3.75,2.5 L12.25,2.5 C12.7,2.5 13,2.8 13,3.25 L13,13.5 L4.5,13.5 C3.7,13.5 3,12.8 3,12 Z M3,12 C3,11.2 3.7,10.5 4.5,10.5 L13,10.5 M6,5.5 L10,5.5</Geometry>
  <Geometry x:Key="IconUser">M8,8 A2.75,2.75 0 1 0 8,2.5 A2.75,2.75 0 1 0 8,8 Z M2.75,14 C2.75,11.2 5.1,9.75 8,9.75 C10.9,9.75 13.25,11.2 13.25,14</Geometry>
  <Geometry x:Key="IconPulse">M1.5,8 L4.5,8 L6.5,3 L9.5,13 L11.5,8 L14.5,8</Geometry>
  <Geometry x:Key="IconInfo">M8,1.75 A6.25,6.25 0 1 1 8,14.25 A6.25,6.25 0 1 1 8,1.75 Z M8,7.25 L8,11 M8,4.9 L8,5</Geometry>
  <Geometry x:Key="IconSearch">M7,2.5 A4.5,4.5 0 1 1 7,11.5 A4.5,4.5 0 1 1 7,2.5 Z M10.4,10.4 L13.5,13.5</Geometry>
  <Geometry x:Key="IconCopy">M6.75,5.5 L12.25,5.5 C12.95,5.5 13.5,6.05 13.5,6.75 L13.5,12.25 C13.5,12.95 12.95,13.5 12.25,13.5 L6.75,13.5 C6.05,13.5 5.5,12.95 5.5,12.25 L5.5,6.75 C5.5,6.05 6.05,5.5 6.75,5.5 Z M3,10.5 L3,3.75 C3,3.05 3.55,2.5 4.25,2.5 L10.5,2.5</Geometry>
  <Geometry x:Key="IconTrash">M2.5,4.5 L13.5,4.5 M6.25,4.5 L6.25,2.5 L9.75,2.5 L9.75,4.5 M4,4.5 L4.75,13.5 L11.25,13.5 L12,4.5</Geometry>
  <Geometry x:Key="IconRecover">M2.5,2.75 L2.5,6.5 L6.25,6.5 M2.9,6.5 A5.5,5.5 0 1 1 2.75,9.75</Geometry>
  <Geometry x:Key="IconDownload">M8,2.5 L8,10 M4.75,6.75 L8,10 L11.25,6.75 M2.5,13.5 L13.5,13.5</Geometry>
  <Geometry x:Key="IconUpload">M8,10 L8,2.5 M4.75,5.75 L8,2.5 L11.25,5.75 M2.5,13.5 L13.5,13.5</Geometry>
  <Geometry x:Key="IconAudioFile">M9.5,1.75 L4.25,1.75 C3.85,1.75 3.5,2.1 3.5,2.5 L3.5,13.5 C3.5,13.9 3.85,14.25 4.25,14.25 L11.75,14.25 C12.15,14.25 12.5,13.9 12.5,13.5 L12.5,4.75 Z M9.5,1.75 L9.5,4.75 L12.5,4.75 M6.25,9.25 L6.25,11 M8,8 L8,12.25 M9.75,9.25 L9.75,11</Geometry>
  <Geometry x:Key="IconBookmark">M4.75,2.5 L11.25,2.5 C11.66,2.5 12,2.84 12,3.25 L12,13.5 L8,10.5 L4,13.5 L4,3.25 C4,2.84 4.34,2.5 4.75,2.5 Z</Geometry>
  <Geometry x:Key="IconGlobe">M8,1.75 A6.25,6.25 0 1 1 8,14.25 A6.25,6.25 0 1 1 8,1.75 Z M1.75,8 L14.25,8 M8,1.75 C6.1,4 6.1,12 8,14.25 M8,1.75 C9.9,4 9.9,12 8,14.25</Geometry>
  <Geometry x:Key="IconPaste">M5.5,3 L4.25,3 C3.85,3 3.5,3.35 3.5,3.75 L3.5,13.5 C3.5,13.9 3.85,14.25 4.25,14.25 L11.75,14.25 C12.15,14.25 12.5,13.9 12.5,13.5 L12.5,3.75 C12.5,3.35 12.15,3 11.75,3 L10.5,3 M6,1.75 L10,1.75 L10,4.25 L6,4.25 Z</Geometry>
  <Geometry x:Key="IconChevronDown">M4,6 L8,10 L12,6</Geometry>
  <Geometry x:Key="IconCheck">M3.5,8.5 L6.5,11.5 L12.5,4.5</Geometry>
  <Geometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</Geometry>
  <Geometry x:Key="IconKeyboard">M2.5,4 L13.5,4 C14.05,4 14.5,4.45 14.5,5 L14.5,11 C14.5,11.55 14.05,12 13.5,12 L2.5,12 C1.95,12 1.5,11.55 1.5,11 L1.5,5 C1.5,4.45 1.95,4 2.5,4 Z M4.5,6.75 L4.6,6.75 M7,6.75 L7.1,6.75 M9.5,6.75 L9.6,6.75 M12,6.75 L12.1,6.75 M5.5,9.5 L10.5,9.5</Geometry>
  <Geometry x:Key="IconStop">M5,4 L11,4 C11.55,4 12,4.45 12,5 L12,11 C12,11.55 11.55,12 11,12 L5,12 C4.45,12 4,11.55 4,11 L4,5 C4,4.45 4.45,4 5,4 Z</Geometry>
  <Geometry x:Key="IconMore">M3.5,8 L3.55,8 M8,8 L8.05,8 M12.5,8 L12.55,8</Geometry>
  <Geometry x:Key="IconSpeaker">M2.5,6 L5,6 L8.5,3 L8.5,13 L5,10 L2.5,10 Z M11,5.5 C12,6.5 12,9.5 11,10.5 M12.75,3.75 C14.75,5.75 14.75,10.25 12.75,12.25</Geometry>

  <!-- Keyboard focus ring, shown for Tab navigation only. -->
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
   <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
  </ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="Icon" TargetType="Path">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
   <Setter Property="StrokeThickness" Value="1.4"/><Setter Property="StrokeLineJoin" Value="Round"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Text -->
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="2,30,0,10"/></Style>
  <Style x:Key="SectionDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="2,-6,0,12"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="RowDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="LineHeight" Value="18"/></Style>
  <Style x:Key="Keycap" TargetType="Border">
   <Setter Property="Background" Value="#161616"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="BorderThickness" Value="1,1,1,2"/>
   <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,1,10,3"/><Setter Property="Margin" Value="4,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The large line above a composer: "Press [Ctrl] [Alt] [Space] to dictate". -->
  <Style x:Key="HintWords" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
  <Style x:Key="HintNote" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,12,0,0"/></Style>

  <!-- Layout -->
  <Style x:Key="PageScroll" TargetType="ScrollViewer">
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="PanningMode" Value="VerticalOnly"/><Setter Property="Focusable" Value="False"/>
  </Style>
  <Style x:Key="PageColumn" TargetType="StackPanel"><Setter Property="MaxWidth" Value="840"/><Setter Property="Margin" Value="40,28,40,48"/></Style>
  <!-- Dictate and Meetings: a centred column with a hint, one composer card and chips under it. -->
  <Style x:Key="ComposerColumn" TargetType="StackPanel"><Setter Property="MaxWidth" Value="760"/><Setter Property="Margin" Value="40,40,40,48"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Composer" TargetType="Border">
   <Setter Property="Margin" Value="0,28,0,0"/><Setter Property="Background" Value="#101010"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style x:Key="Row" TargetType="Border">
   <Setter Property="Padding" Value="16,12"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>

  <!-- Notice cards, see NoticeStack: a coloured left edge, the kind in small capitals, a title, one or two lines and the x. -->
  <Style x:Key="NoticeCard" TargetType="Border">
   <Setter Property="Background" Value="#0F0F0F"/><Setter Property="BorderThickness" Value="3,1,1,1"/><Setter Property="CornerRadius" Value="11"/>
   <Setter Property="Padding" Value="14,10,8,11"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  </Style>
  <Style x:Key="NoticeKind" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,34,3"/></Style>
  <Style x:Key="NoticeText" TargetType="TextBlock"><Setter Property="Foreground" Value="#B5B5B5"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,26,0"/></Style>

  <!-- Buttons: bordered by default; Primary is the blue action of a page. -->
  <ControlTemplate x:Key="ButtonChrome" TargetType="Button">
   <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
   </Border>
  </ControlTemplate>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#121212"/>
   <Setter Property="BorderBrush" Value="#2C2C2C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template" Value="{StaticResource ButtonChrome}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C1C1C"/><Setter Property="BorderBrush" Value="#3C3C3C"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#262626"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2F5FE0"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Selected}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#B8B8B8"/>
  </Style>
  <Style x:Key="NoticeDismiss" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,-3,0,0"/>
  </Style>
  <!-- The status line's pointer to a notice on another page: the status text's look, underlined, a link to that page. -->
  <Style x:Key="StatusPointer" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,6,0,0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NoticeToggle" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="6,2"/>
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,4,4,0"/>
  </Style>
  <!-- Picker pill under the composer: opens a menu of choices. -->
  <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="9,4,7,4"/>
   <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="Background" Value="#0B0B0B"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="BorderBrush" Value="{StaticResource EdgeHover}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ChipChevron" TargetType="Path" BasedOn="{StaticResource Icon}">
   <Setter Property="Data" Value="{StaticResource IconChevronDown}"/><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Margin" Value="6,1,0,0"/><Setter Property="Stroke" Value="{StaticResource Muted}"/>
  </Style>
  <!-- Cancel only appears while there is something to cancel. -->
  <!-- A quiet secondary action next to the record control on Dictate and Meetings, shown only while it applies. -->
  <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#FF7B72"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#241010"/><Setter Property="BorderBrush" Value="#5C2626"/></Trigger>
   </Style.Triggers>
  </Style>
  <!-- The prominent Cancel of a confirmation: backing out is the safe choice. -->
  <Style x:Key="DangerFilled" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Background" Value="#C93C37"/>
   <Setter Property="BorderBrush" Value="#C93C37"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DA4E49"/><Setter Property="BorderBrush" Value="#DA4E49"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#A9302C"/></Trigger>
   </Style.Triggers>
  </Style>
  <!-- Round record control: blue with a microphone, red with a stop square while recording, without a glyph while a meeting is finished. -->
  <Style x:Key="Record" TargetType="Button" BasedOn="{StaticResource Primary}">
   <Setter Property="Padding" Value="14,0,16,0"/><Setter Property="Height" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="17" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path x:Name="Glyph" Style="{StaticResource Icon}" Data="{StaticResource IconMicrophone}" Stroke="#FFFFFF" Margin="0,0,8,0"/>
      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Content" Value="Stop"><Setter TargetName="Glyph" Property="Data" Value="{StaticResource IconStop}"/><Setter TargetName="Glyph" Property="Fill" Value="#FFFFFF"/><Setter TargetName="Chrome" Property="Background" Value="#E5484D"/></Trigger>
     <Trigger Property="Content" Value="Stop and finish"><Setter TargetName="Glyph" Property="Data" Value="{StaticResource IconStop}"/><Setter TargetName="Glyph" Property="Fill" Value="#FFFFFF"/><Setter TargetName="Chrome" Property="Background" Value="#E5484D"/></Trigger>
     <Trigger Property="Content" Value="Continue in background"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text fields: placeholder text comes from Tag. -->
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Field}"/>
   <Setter Property="BorderBrush" Value="#2A2A2A"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
     <Grid>
      <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed"/>
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="Hidden"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource EdgeHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Borderless editor inside the dictation composer and for read-only reports in cards. -->
  <!-- A shortcut field. While it is locked it loses its field background and border, so it does not look like a field that takes keys. -->
  <Style x:Key="ShortcutField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="16,14"/>
   <Setter Property="VerticalContentAlignment" Value="Top"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="34,7,30,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
     <Grid>
      <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource Muted}" HorizontalAlignment="Left" Margin="11,0,0,0"/>
      <TextBlock x:Name="Placeholder" Text="Search" Foreground="{StaticResource Muted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
      <Border x:Name="SlashHint" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="5" Padding="6,0,6,1" Visibility="Collapsed">
       <TextBlock Text="/" FontSize="12" Foreground="{StaticResource Muted}"/>
      </Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/><Setter TargetName="SlashHint" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#0E0E0E"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="SlashHint" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- The search in a page header: no slash hint, which belongs to the sidebar search; the placeholder comes from Tag. -->
  <Style x:Key="PageSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Padding" Value="34,6,10,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
     <Grid>
      <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource Muted}" HorizontalAlignment="Left" Margin="11,0,0,0"/>
      <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource EdgeHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Tabs above a page's content, such as Transcript and Notes on the History page. -->
  <Style x:Key="Tab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" CornerRadius="8" Padding="12,6" Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Toggle switch: grey off, blue track with white knob on. -->
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="#2E2E2E" VerticalAlignment="Center">
      <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#8A8A8A" HorizontalAlignment="Left" Margin="3,0">
       <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
     </Border>
     <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
      <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
      <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
     </Trigger>
     <MultiTrigger>
      <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
      <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHover}"/>
     </MultiTrigger>
     <MultiTrigger>
      <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions>
      <Setter TargetName="Track" Property="Background" Value="#3A3A3A"/>
      <Setter TargetName="Knob" Property="Fill" Value="#B0B0B0"/>
     </MultiTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Selectable option row with a radio mark, used for output styles. -->
  <Style x:Key="Option" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" CornerRadius="8" Padding="14,12" Background="Transparent">
     <DockPanel>
      <Grid DockPanel.Dock="Right" Width="18" Height="18" Margin="20,0,0,0" VerticalAlignment="Center">
       <Ellipse x:Name="Ring" Stroke="#3C3C3C" StrokeThickness="1.5"/>
       <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FFFFFF" Visibility="Collapsed"/>
      </Grid>
      <ContentPresenter/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#121212"/><Setter TargetName="Ring" Property="Stroke" Value="#5A5A5A"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Chrome" Property="Background" Value="#151515"/>
      <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Accent}"/><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
      <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Select: field look with a chevron; the open list marks the current choice with a check. -->
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Chrome" Padding="10,7" CornerRadius="6" Background="Transparent">
     <DockPanel>
      <Path x:Name="Check" DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Stroke="{StaticResource Ink}" Margin="16,0,0,0" Visibility="Hidden"/>
      <ContentPresenter VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" BorderBrush="#2A2A2A" Background="{StaticResource Field}" SnapsToDevicePixels="True">
        <Path Style="{StaticResource Icon}" Data="{StaticResource IconChevronDown}" Stroke="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,10,0" Width="16" Height="16"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource EdgeHover}"/><Setter TargetName="Chrome" Property="Background" Value="#141414"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Margin="12,7,34,7" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Margin="0,6,12,12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" CornerRadius="10" BorderThickness="1" BorderBrush="#2E2E2E" Background="#111111" Padding="4">
       <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity=".6" Color="#000000"/></Border.Effect>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Collapsible row: title left, chevron right. -->
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{TemplateBinding Header}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Chrome" CornerRadius="8" Padding="12,11" Background="Transparent">
        <DockPanel>
         <Path x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource IconChevronDown}" Stroke="{StaticResource Muted}" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform></Path>
         <TextBlock x:Name="Title" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{StaticResource Secondary}" FontWeight="SemiBold" FontSize="13.5"/>
        </DockPanel>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#121212"/><Setter TargetName="Title" Property="Foreground" Value="{StaticResource Ink}"/><Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ink}"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
         <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
         <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="12,2,12,12"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slim scroll bars. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border x:Name="Bar" CornerRadius="3" Background="#222222"/>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#4A4A4A"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/>
   <Setter Property="MinWidth" Value="8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2"><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb></Track>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Horizontal">
     <Setter Property="Width" Value="Auto"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="Height" Value="10"/>
     <Setter Property="MinHeight" Value="10"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Margin="2"><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb></Track>
     </ControlTemplate></Setter.Value></Setter>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Menus: chip pickers and text field context menus. -->
  <Style TargetType="ContextMenu">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="#111111" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,14,14">
     <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity=".6" Color="#000000"/></Border.Effect>
     <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Chrome" Padding="10,7" CornerRadius="6" Background="Transparent" MinWidth="210">
     <DockPanel>
      <Path x:Name="Check" DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Stroke="{StaticResource Ink}" Margin="16,0,0,0" Visibility="Hidden"/>
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="6" Padding="8,5" MaxWidth="320">
     <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Lists -->
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Padding="10,8" CornerRadius="8" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Sidebar navigation entries. -->
  <Style x:Key="NavigationEntry" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
   <Setter Property="AutomationProperties.ItemStatus" Value="{Binding MarkerStatus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Padding="10,6" CornerRadius="8" Background="Transparent">
     <DockPanel>
      <Ellipse x:Name="Marker" DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding Marker}" VerticalAlignment="Center" Margin="8,0,2,0"/>
      <Path x:Name="Glyph" Style="{StaticResource Icon}" Data="{Binding Icon}" Stroke="{StaticResource Muted}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#131313"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Ink}"/></Trigger>
     <DataTrigger Binding="{Binding Marker}" Value="{x:Null}"><Setter TargetName="Marker" Property="Visibility" Value="Collapsed"/></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Entries of an editable list. The box shows the selection; clicking it adds or removes its entry without Ctrl, so the toggle switch style does not fit. -->
  <Style x:Key="SelectionBox" TargetType="CheckBox">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="#4A4A4A" Background="Transparent">
     <Path x:Name="Mark" Data="{StaticResource IconCheck}" Width="10" Height="10" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#7A7A7A"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ListEntry" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Padding="10,6" CornerRadius="8" Background="Transparent">
     <DockPanel>
      <CheckBox Style="{StaticResource SelectionBox}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Tables sit inside cards: no own frame, muted headers, quiet row lines. -->
  <Style TargetType="DataGrid">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowBackground" Value="Transparent"/>
   <Setter Property="AlternatingRowBackground" Value="Transparent"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
   <Setter Property="FontSize" Value="13.5"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGrid">
    <Border Background="{TemplateBinding Background}" Padding="4,0,4,4">
     <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
      <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"/>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
       </Grid>
      </ControlTemplate></ScrollViewer.Template>
      <ItemsPresenter/>
     </ScrollViewer>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
    <Grid Background="Transparent">
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,11,9,9">
      <StackPanel Orientation="Horizontal">
       <ContentPresenter VerticalAlignment="Center"/>
       <Path x:Name="SortArrow" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center" Data="M0,4 L4,0 L8,4" Stroke="{StaticResource Muted}" StrokeThickness="1.4" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
      </StackPanel>
     </Border>
     <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Opacity="0"/>
     <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridRow">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#111111"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="11,6">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsEditing" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Columns assign explicit element styles, so WorkspacePages.Grid applies these keyed ones. -->
  <Style x:Key="CellEditor" TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CellToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="CellToggleDisplay" TargetType="CheckBox" BasedOn="{StaticResource CellToggle}">
   <Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="Focusable" Value="False"/>
  </Style>
</ResourceDictionary>
