<Window x:Class="PrivateFlow.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PrivateFlow.Windows" Title="Private Flow" Width="1240" Height="800" MinWidth="900" MinHeight="560" Background="#000000" Foreground="#F5F5F5" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" UseLayoutRounding="True" PreviewTextInput="FocusSearchOnSlash">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar: search, the pages, the settings button and the live dictation status. -->
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#080808">
   <DockPanel Margin="10,12,10,12">
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" AutomationProperties.Name="Search pages and settings" TextChanged="SearchChanged" PreviewKeyDown="SearchKeyDown"/>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,6,0" Margin="0,10,0,0">
     <DockPanel>
      <Button x:Name="SettingsButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,0,8,0" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings">
       <Grid>
        <Path Style="{StaticResource Icon}" Data="{StaticResource IconGear}"/>
        <Ellipse x:Name="SettingsUnsavedDot" Width="6" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/>
        <Ellipse x:Name="SettingsUnseenDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2" Visibility="Collapsed"/>
       </Grid>
      </Button>
      <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Top" Margin="0,12,10,0"/>
      <Grid>
       <TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Margin="0,6,0,0" Foreground="{StaticResource Secondary}" AutomationProperties.Name="Status"/>
       <!-- The newest warning or error of a page not in view, in place of the status line; it opens that page. -->
       <Button x:Name="StatusPointer" Style="{StaticResource StatusPointer}" Click="StatusPointerClick" Visibility="Collapsed" ToolTip="Open the page with this notice">
        <TextBlock x:Name="StatusPointerText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" TextDecorations="Underline"/>
       </Button>
      </Grid>
     </DockPanel>
    </Border>
    <ListBox x:Name="Navigation" Margin="0,12,0,0" ItemContainerStyle="{StaticResource NavigationEntry}" SelectionChanged="NavigationChanged" AutomationProperties.Name="Pages" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.GroupStyle>
      <GroupStyle>
       <GroupStyle.HeaderTemplate>
        <DataTemplate>
         <TextBlock x:Name="Header" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,18,0,6"/>
         <DataTemplate.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter TargetName="Header" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
       </GroupStyle.HeaderTemplate>
      </GroupStyle>
     </ListBox.GroupStyle>
    </ListBox>
   </DockPanel>
  </Border>

  <DockPanel Grid.Column="1">
   <!-- Breadcrumb header with the open page's actions. -->
   <Border DockPanel.Dock="Top" Height="54" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,0,16,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <ContentControl x:Name="PreferenceSlot" Focusable="False">
       <StackPanel x:Name="PreferenceActions" Orientation="Horizontal" Visibility="Collapsed">
        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="Unsaved changes" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Style="{StaticResource Ghost}" Content="Discard" Click="DiscardClick" Margin="0,0,8,0"/>
        <Button x:Name="SavePreferencesButton" Style="{StaticResource Primary}" Content="Save preferences" Click="SaveClick"/>
       </StackPanel>
      </ContentControl>
      <ContentControl x:Name="PageActions" Focusable="False"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Private Flow" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="/" Foreground="#4A4A4A" Margin="10,0"/>
      <TextBlock x:Name="PageTitle" Text="Dictate" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <Grid x:Name="Pages">
    <!-- Dictate: the shortcut, the last transcription in a composer and its context. -->
    <ScrollViewer x:Name="DictatePage" Style="{StaticResource PageScroll}">
     <StackPanel Style="{StaticResource ComposerColumn}">
      <WrapPanel x:Name="ShortcutHint" HorizontalAlignment="Center"/>
      <TextBlock x:Name="ShortcutNote" Style="{StaticResource HintNote}" Text="Press it again to paste into the field you started in. Esc cancels."/>
      <local:NoticeStack x:Name="DictateNotices" Margin="0,24,0,0" AutomationProperties.Name="Dictate notices"/>

      <Border Style="{StaticResource Composer}">
       <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="CancelButton" Style="{StaticResource QuietAction}" Content="Cancel" Click="CancelClick" IsEnabled="False" Margin="0,0,8,0"/>
          <Button x:Name="RecordButton" Style="{StaticResource Record}" Content="Record" Click="RecordClick"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Click="CopyClick" ToolTip="Copy text" AutomationProperties.Name="Copy text"><Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}"/></Button>
          <Button Style="{StaticResource IconButton}" Click="RecoverClick" ToolTip="Recover the last result" AutomationProperties.Name="Recover the last result"><Path Style="{StaticResource Icon}" Data="{StaticResource IconRecover}"/></Button>
          <Button Style="{StaticResource IconButton}" Click="ExportClick" ToolTip="Export text" AutomationProperties.Name="Export text"><Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}"/></Button>
          <Button Style="{StaticResource IconButton}" Click="ClearClick" ToolTip="Clear" AutomationProperties.Name="Clear the last result"><Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}"/></Button>
          <Button x:Name="KeepClipButton" Style="{StaticResource IconButton}" Click="KeepClipClick" ToolTip="Keep as test clip: saves this dictation's audio with the text as corrected, on this PC only" AutomationProperties.Name="Keep as test clip" Visibility="Collapsed"><Path Style="{StaticResource Icon}" Data="{StaticResource IconBookmark}"/></Button>
          <Border Width="1" Height="18" Background="{StaticResource Edge}" Margin="6,0"/>
          <Button x:Name="ImportButton" Style="{StaticResource Ghost}" Foreground="#B8B8B8" Click="ImportClick" ToolTip="Transcribe an audio file on this PC" Padding="8,6">
           <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconAudioFile}" Margin="0,0,8,0"/><TextBlock Text="Transcribe file"/></StackPanel>
          </Button>
         </StackPanel>
        </DockPanel>
        <TextBox x:Name="Transcript" Style="{StaticResource BareTextBox}" MinHeight="136" MaxHeight="320" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" Tag="Your latest dictation appears here. Edit it before you copy or export it." AutomationProperties.Name="Last transcription"/>
       </DockPanel>
      </Border>

      <WrapPanel Margin="2,12,2,0">
       <Button x:Name="MicrophoneChip" Style="{StaticResource Chip}" Click="ChipClick" ToolTip="Microphone">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconMicrophone}" Margin="0,0,7,0"/><TextBlock x:Name="MicrophoneChipText" MaxWidth="220" TextTrimming="CharacterEllipsis"/><Path Style="{StaticResource ChipChevron}"/></StackPanel>
       </Button>
       <Button x:Name="LanguageChip" Style="{StaticResource Chip}" Click="ChipClick" ToolTip="Language">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconGlobe}" Margin="0,0,7,0"/><TextBlock x:Name="LanguageChipText"/><Path Style="{StaticResource ChipChevron}"/></StackPanel>
       </Button>
       <Button x:Name="OutputChip" Style="{StaticResource Chip}" Click="ChipClick" ToolTip="Text style">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconSparkle}" Margin="0,0,7,0"/><TextBlock x:Name="OutputChipText"/><Path Style="{StaticResource ChipChevron}"/></StackPanel>
       </Button>
       <Button x:Name="PasteChip" Style="{StaticResource Chip}" Click="ChipClick" ToolTip="Insertion">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconPaste}" Margin="0,0,7,0"/><TextBlock x:Name="PasteChipText"/><Path Style="{StaticResource ChipChevron}"/></StackPanel>
       </Button>
       <Button x:Name="ProfileChip" Style="{StaticResource Chip}" Click="EndProfileClick" Visibility="Collapsed" ToolTip="Its language, text style, vocabulary and pasting apply to your dictations; your preferences stay as they are. Press to end it.">
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconUser}" Margin="0,0,7,0"/><TextBlock x:Name="ProfileChipText"/><TextBlock Text="×" Margin="8,0,0,0"/></StackPanel>
       </Button>
      </WrapPanel>

      <Border Style="{StaticResource Card}" Padding="4" Margin="0,28,0,0">
       <StackPanel>
        <Expander Header="Changes from original"><TextBox x:Name="Diff" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalContentAlignment="Top" AutomationProperties.Name="Original and final difference"/></Expander>
        <Border Height="1" Background="{StaticResource Line}" Margin="8,0"/>
        <Expander Header="Original transcription"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalContentAlignment="Top" AutomationProperties.Name="Original transcription"/></Expander>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <!-- Vocabulary: what the user teaches the app for dictation and meetings. Corrections and snippets follow from code. -->
    <ScrollViewer x:Name="VocabularyPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
     <StackPanel x:Name="VocabularyColumn" Style="{StaticResource PageColumn}">
      <TextBlock Style="{StaticResource SectionHeading}" Text="Names and terms" Margin="2,0,0,12"/>
      <TextBlock Style="{StaticResource SectionDescription}" Text="Spellings the recognizer should prefer in dictation and in meetings. Plain text, never a replacement rule."/>
      <Border x:Name="VocabularyEditor" Style="{StaticResource Card}" PreviewKeyDown="VocabularyEditorKeyDown"><StackPanel>
       <Border Style="{StaticResource Row}" BorderThickness="0"><StackPanel>
        <TextBlock Style="{StaticResource RowTitle}" Text="Vocabulary"/>
        <TextBlock Style="{StaticResource RowDescription}" Text="Meetings also take the corrected spellings below and the meeting title as hints; their transcripts are not rewritten."/>
        <DockPanel Margin="0,12,0,0">
         <Button x:Name="AddTermsButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="Add" Height="34" Padding="16,0" Margin="8,0,0,0" Click="AddTermsClick" AutomationProperties.Name="Add to vocabulary"/>
         <TextBox x:Name="VocabularyEntry" MinHeight="34" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" Tag="A name or term; several separated by commas" PreviewKeyDown="VocabularyEntryKeyDown" TextChanged="VocabularyEntryChanged" AutomationProperties.Name="New vocabulary term"/>
        </DockPanel>
        <TextBlock x:Name="VocabularyHint" Style="{StaticResource RowDescription}" Margin="2,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Row}" Padding="16,10,16,12"><DockPanel>
        <DockPanel DockPanel.Dock="Top">
         <Button x:Name="DeleteTermsButton" DockPanel.Dock="Right" Style="{StaticResource Danger}" Content="Delete selected" IsEnabled="False" Click="DeleteTermsClick" AutomationProperties.Name="Delete selected"/>
         <TextBlock x:Name="VocabularyCount" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="VocabularyList" SelectionMode="Extended" MaxHeight="420" Margin="-10,8,-10,0" ItemContainerStyle="{StaticResource ListEntry}" SelectionChanged="VocabularySelectionChanged" ButtonBase.Click="VocabularyBoxClick"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Vocabulary"/>
       </DockPanel></Border>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </DockPanel>

  <!-- Settings, shown over the dimmed window from the button at the bottom of the sidebar. The window detaches it at start. -->
  <Border x:Name="SettingsDialog" Grid.ColumnSpan="2" Margin="48,36" MaxWidth="1120" MaxHeight="800" Background="#0A0A0A" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" KeyDown="SettingsKeyDown">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#080808" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" CornerRadius="14,0,0,14">
     <DockPanel Margin="10,12,10,12">
      <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" AutomationProperties.Name="Search settings" TextChanged="SettingsSearchChanged" PreviewKeyDown="SettingsSearchKeyDown"/>
      <ListBox x:Name="SettingsNavigation" Margin="0,12,0,0" ItemContainerStyle="{StaticResource NavigationEntry}" SelectionChanged="SettingsNavigationChanged" AutomationProperties.Name="Settings sections" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.GroupStyle>
        <GroupStyle>
         <GroupStyle.HeaderTemplate>
          <DataTemplate>
           <TextBlock x:Name="Header" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,18,0,6"/>
           <DataTemplate.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter TargetName="Header" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
          </DataTemplate>
         </GroupStyle.HeaderTemplate>
        </GroupStyle>
       </ListBox.GroupStyle>
      </ListBox>
     </DockPanel>
    </Border>
    <DockPanel Grid.Column="1">
     <Border DockPanel.Dock="Top" Height="54" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,0,10,0">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <ContentControl x:Name="SettingsPreferenceSlot" Focusable="False"/>
        <ContentControl x:Name="SettingsActions" Focusable="False"/>
        <Button Style="{StaticResource IconButton}" Margin="12,0,0,0" Click="CloseSettingsClick" ToolTip="Close (Esc)" AutomationProperties.Name="Close settings"><Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/></Button>
       </StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Settings" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="/" Foreground="#4A4A4A" Margin="10,0"/>
        <TextBlock x:Name="SettingsTitle" FontWeight="SemiBold"/>
       </StackPanel>
      </DockPanel>
     </Border>

     <Grid x:Name="SettingsPages">
      <ScrollViewer x:Name="AudioSection" Style="{StaticResource PageScroll}" Visibility="Collapsed">
       <StackPanel Style="{StaticResource PageColumn}">
        <local:NoticeStack x:Name="AudioNotices" AutomationProperties.Name="Microphone and speakers notices"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Microphone" Margin="2,0,0,12"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <ComboBox x:Name="Microphones" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" SelectionChanged="ContextChanged" AutomationProperties.Name="Microphone"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Input device"/><TextBlock Style="{StaticResource RowDescription}" Text="Used by dictation and meetings. Reconnects automatically when the device returns."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
        <TextBlock Style="{StaticResource SectionHeading}" Text="System audio in meetings"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <ComboBox x:Name="PlaybackDevices" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" SelectionChanged="ContextChanged" AutomationProperties.Name="Playback device"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Output device"/><TextBlock Style="{StaticResource RowDescription}" Text="Meetings record what plays on this device, such as the other side of a call. Follow Windows default records the device Windows plays through when the meeting starts, which is also used when a chosen device is not connected."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <ContentControl x:Name="SystemAudioColorHost" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Center" Focusable="False"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="System audio colour"/><TextBlock Style="{StaticResource RowDescription}" Text="While a meeting records, a pill at the bottom of the screen and the wave on the Meetings page show your microphone upwards in white and the system audio downwards in this colour."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ShortcutsSection" Style="{StaticResource PageScroll}" Visibility="Collapsed">
       <StackPanel Style="{StaticResource PageColumn}">
        <local:NoticeStack x:Name="ShortcutsNotices" AutomationProperties.Name="Shortcuts notices"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Dictation shortcut" Margin="2,0,0,12"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <TextBox x:Name="ShortcutBox" Style="{StaticResource ShortcutField}" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" VerticalAlignment="Center" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" TextChanged="PreferenceChanged" ToolTip="Click here, then press your preferred key combination" AutomationProperties.Name="Recording shortcut"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Shortcut"/><TextBlock x:Name="ShortcutFeedback" Style="{StaticResource RowDescription}" Text="Starts and ends recording. Click the field and press a combination with Ctrl, Alt or Win, or a function key."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <ComboBox x:Name="ShortcutBehaviorChoice" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" SelectedIndex="0" SelectionChanged="PreferenceChanged" AutomationProperties.Name="Shortcut behavior"><ComboBoxItem x:Name="ToggleOption" Content="Toggle"/><ComboBoxItem x:Name="HoldToTalkOption" Content="Hold to talk"/></ComboBox>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Shortcut behavior"/><TextBlock Style="{StaticResource RowDescription}" Text="Toggle: press once to record, again to transcribe. Hold to talk: records while you hold the shortcut and transcribes when you release it; a tap under 0.3 s is ignored."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Meeting shortcut"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <TextBox x:Name="MeetingShortcutBox" Style="{StaticResource ShortcutField}" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" VerticalAlignment="Center" IsReadOnly="True" PreviewKeyDown="CaptureMeetingShortcut" TextChanged="PreferenceChanged" ToolTip="Click here, then press a key combination; Backspace removes it" AutomationProperties.Name="Meeting shortcut"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Shortcut"/><TextBlock x:Name="MeetingShortcutFeedback" Style="{StaticResource RowDescription}" Text="Starts a meeting with the choices on the Meetings page and stops it as Stop and finish does. Not set: click the field and press a combination; Backspace removes it."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Profile shortcuts"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <Button DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Center" Content="Open Profiles per app" Click="OpenProfilesClick"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="One per profile"/><TextBlock Style="{StaticResource RowDescription}" Text="Each profile can start dictation with its own shortcut, which follows the shortcut behavior above. Set it under Profiles per app."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="DictationSection" Style="{StaticResource PageScroll}" Visibility="Collapsed">
       <StackPanel Style="{StaticResource PageColumn}">
        <local:NoticeStack x:Name="DictationNotices" AutomationProperties.Name="Language and pasting notices"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Dictation language" Margin="2,0,0,12"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <ComboBox x:Name="Languages" DockPanel.Dock="Right" Width="300" Margin="24,0,0,0" SelectedIndex="0" SelectionChanged="ContextChanged" AutomationProperties.Name="Language"><ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="German" Tag="de"/><ComboBoxItem Content="Spanish" Tag="es"/></ComboBox>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Language"/><TextBlock Style="{StaticResource RowDescription}" Text="Automatic detects English, German or Spanish for each recording."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Pasting"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <CheckBox x:Name="AutoInsert" DockPanel.Dock="Right" Margin="24,0,0,0" Checked="ContextChanged" Unchecked="ContextChanged" AutomationProperties.Name="Paste into the selected field automatically"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Paste into the selected field"/><TextBlock Style="{StaticResource RowDescription}" Text="Pastes into the field you started in, never into password fields. If pasting isn't possible, the text stays on the clipboard to paste yourself."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Formatting and literal text"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <CheckBox x:Name="Formatting" DockPanel.Dock="Right" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="24,0,0,0" AutomationProperties.Name="Spoken formatting"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Spoken formatting"/><TextBlock Style="{StaticResource RowDescription}" Text="Say new paragraph / neuer Absatz, comma / Komma or bullet point. Spell A B C end spelling."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <CheckBox x:Name="Technical" DockPanel.Dock="Right" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="24,0,0,0" AutomationProperties.Name="Protect technical text"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Protect technical text"/><TextBlock Style="{StaticResource RowDescription}" Text="Keeps paths, identifiers, numbers with units and code-like words exactly as recognized."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <CheckBox x:Name="Literal" DockPanel.Dock="Right" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="24,0,0,0" AutomationProperties.Name="Literal mode"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Literal mode"/><TextBlock Style="{StaticResource RowDescription}" Text="Skips aliases, snippets, spoken commands and the rewrite of Concise and Local polish. The Exact text style skips all processing."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="OutputPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
       <StackPanel Style="{StaticResource PageColumn}">
        <local:NoticeStack x:Name="OutputNotices" AutomationProperties.Name="Text style notices"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Text style" Margin="2,0,0,12"/>
        <TextBlock Style="{StaticResource SectionDescription}" Text="Applied to the text after speech recognition on this PC."/>
        <Border Style="{StaticResource Card}" Padding="4"><StackPanel>
         <RadioButton x:Name="OutputExact" Style="{StaticResource Option}" GroupName="Output" Checked="ContextChanged" AutomationProperties.Name="Exact output"><StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Exact"/><TextBlock Style="{StaticResource RowDescription}" Text="Word for word, as transcribed."/></StackPanel></RadioButton>
         <RadioButton x:Name="OutputClean" Style="{StaticResource Option}" GroupName="Output" Checked="ContextChanged" AutomationProperties.Name="Clean output"><StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Clean"/><TextBlock Style="{StaticResource RowDescription}" Text="Removes filler words and stutters on this PC and applies clear spoken corrections (&quot;3 pm, no wait, 4 pm&quot;). Keeps your wording."/></StackPanel></RadioButton>
         <RadioButton x:Name="OutputConcise" Style="{StaticResource Option}" GroupName="Output" Checked="ContextChanged" AutomationProperties.Name="Concise output"><StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Concise"/><TextBlock Style="{StaticResource RowDescription}" Text="Rewritten to the point by the API below, applying spoken corrections (&quot;sorry, I meant …&quot;). Text leaves this PC, never audio; falls back to Clean."/></StackPanel></RadioButton>
         <RadioButton x:Name="OutputLocal" Style="{StaticResource Option}" GroupName="Output" Checked="ContextChanged" AutomationProperties.Name="Local polish output"><StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Local polish"/><TextBlock Style="{StaticResource RowDescription}" Text="Polishes text on this PC with the optional local model. Falls back visibly to Clean when unavailable or unsafe."/></StackPanel></RadioButton>
         <Border Style="{StaticResource Row}" Margin="10,0"><DockPanel>
          <ComboBox x:Name="PolishWait" DockPanel.Dock="Right" Width="160" Margin="24,0,0,0" SelectionChanged="PreferenceChanged" AutomationProperties.Name="Local polish wait for meeting notes"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Wait for meeting notes"/><TextBlock Style="{StaticResource RowDescription}" Text="While meeting notes are written on this PC, Local polish waits this long, then pastes Clean."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>

        <TextBlock Style="{StaticResource SectionHeading}" Text="Concise API connection"/>
        <TextBlock Style="{StaticResource SectionDescription}" Text="Used by the Concise style and by meeting notes written by the API. The key is read from an environment variable and never saved in settings."/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <TextBox x:Name="RewriteEndpoint" DockPanel.Dock="Right" TextChanged="PreferenceChanged" Width="300" Margin="24,0,0,0" AutomationProperties.Name="Concise API base URL"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Base URL"/><TextBlock Style="{StaticResource RowDescription}" Text="OpenAI-compatible endpoint."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <TextBox x:Name="RewriteModel" DockPanel.Dock="Right" TextChanged="PreferenceChanged" Width="300" Margin="24,0,0,0" AutomationProperties.Name="Concise model"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Model"/><TextBlock Style="{StaticResource RowDescription}" Text="Model name sent with each request."/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <TextBox x:Name="RewriteKeyVariable" DockPanel.Dock="Right" TextChanged="PreferenceChanged" Width="300" Margin="24,0,0,0" AutomationProperties.Name="Environment variable holding the API key"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="API key variable"/><TextBlock Style="{StaticResource RowDescription}" Text="Environment variable that holds the API key."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="AboutPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
       <StackPanel Style="{StaticResource PageColumn}">
        <local:NoticeStack x:Name="AboutNotices" AutomationProperties.Name="About and updates notices"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Version, privacy and quitting" Margin="2,0,0,12"/>
        <Border Style="{StaticResource Card}"><StackPanel>
         <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
          <Button x:Name="UpdateButton" DockPanel.Dock="Right" Margin="24,0,0,0" Content="Update" Click="UpdateClick" ToolTip="Install from your configured update server or the latest public release and restart"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Updates"/><TextBlock x:Name="VersionText" Style="{StaticResource RowDescription}"/><TextBlock x:Name="BuildText" Style="{StaticResource RowDescription}"/></StackPanel>
         </DockPanel></Border>
         <Border Style="{StaticResource Row}"><StackPanel>
          <TextBlock Style="{StaticResource RowTitle}" Text="Privacy"/><TextBlock Style="{StaticResource RowDescription}" Text="Audio and speech recognition never leave this PC. Text, never audio, goes to the API you configure only as the dictated text with the Concise style, or as one meeting's title, languages, vocabulary and transcript text when you press its notes button with the API notes style."/>
         </StackPanel></Border>
         <Border Style="{StaticResource Row}"><StackPanel>
          <TextBlock Style="{StaticResource RowTitle}" Text="Tray"/><TextBlock Style="{StaticResource RowDescription}" Text="Closing this window keeps Private Flow running in the tray. Double-click the tray icon to open it again."/>
         </StackPanel></Border>
         <Border Style="{StaticResource Row}"><DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Danger}" Margin="24,0,0,0" Content="Quit" Click="QuitClick" AutomationProperties.Name="Quit Private Flow"/>
          <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Quit Private Flow"/><TextBlock Style="{StaticResource RowDescription}" Text="Cancels a running dictation, stops meetings and removes the tray icon."/></StackPanel>
         </DockPanel></Border>
        </StackPanel></Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </DockPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
