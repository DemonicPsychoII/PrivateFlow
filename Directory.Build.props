<Project><PropertyGroup><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
<!-- Published packages are public: the debug symbols name neither the checkout folder nor the development repository. -->
<PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap><EnableSourceLink>false</EnableSourceLink></PropertyGroup>
<!-- A release build (a version tag in the release workflow) is public: its build identity is "<version>+release" instead of the
     development commit, and the build reads nothing from Git. scripts/release.py check-symbols refuses the commit in its binaries. -->
<PropertyGroup Condition="'$(GITHUB_REF_TYPE)' == 'tag'"><SourceRevisionId>release</SourceRevisionId><EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries></PropertyGroup></Project>
